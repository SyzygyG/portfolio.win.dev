{
  "name": "erwin-gamalong-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Erwin Gamalong — full stack developer & project manager. Editorial engineering portfolio, built with PHP and Tailwind CSS.",
  "scripts": {
    "build:css": "tailwindcss -i src/css/main.css -o dist/assets/main.css --minify",
    "build:site": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "watch:css": "tailwindcss -i src/css/main.css -o dist/assets/main.css --watch",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "php-wasm": "0.0.9-alpha-32",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@10.0.0"
}
